<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="0" android:startColor="#996A4BFF" android:endColor="#3348C8FF" />
            <stroke android:width="2dp" android:color="#6FE7FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#336FE7FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#12FFFFFF" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
