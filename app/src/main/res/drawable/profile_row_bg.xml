<?xml version="1.0" encoding="utf-8"?>
<!-- Penumbra: glass row for the profiles list -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#26FFFFFF" />
            <stroke android:width="2dp" android:color="#6FE7FF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <gradient android:angle="0" android:startColor="#556A4BFF" android:endColor="#1A48C8FF" />
            <stroke android:width="1dp" android:color="#66A98BFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#1FFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#12FFFFFF" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
