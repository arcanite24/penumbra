<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="108dp"
    android:layout_height="108dp"
    android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:layout_gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/home_focus_ring"
    android:padding="4dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="#1B1840"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp">

        <ImageView
            android:id="@+id/grid_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/grid_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="#E8E6FF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/home_item_live"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/home_live_badge"
            android:gravity="center"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:text="@string/home_live"
            android:textColor="#050418"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </androidx.cardview.widget.CardView>
</FrameLayout>
