<?xml version="1.0" encoding="utf-8"?>
<!-- Penumbra setup wizard (PEN-8): step rail on the left, step content on the right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050418">

    <com.limelight.ui.EclipseBackgroundView
        android:id="@+id/wizardEclipse"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/wizardContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="14dp"
        android:paddingEnd="28dp"
        android:paddingBottom="14dp">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/wizardBack"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/home_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:importantForAccessibility="no"
                    android:src="@mipmap/ic_launcher_foreground" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/wizard_title"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/home_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="14dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/home_status_dot" />

                <TextView
                    android:id="@+id/wizardHost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    tools:text="multivac" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Step rail -->
            <LinearLayout
                android:id="@+id/wizardRail"
                android:layout_width="230dp"
                android:layout_height="match_parent"
                android:orientation="vertical" />

            <!-- Step panel -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:background="@drawable/home_panel">

                <ScrollView
                    android:id="@+id/wizardScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fadingEdgeLength="24dp"
                    android:requiresFadingEdge="vertical"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/wizardBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="26dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="26dp"
                        android:paddingBottom="20dp" />
                </ScrollView>
            </FrameLayout>
        </LinearLayout>

        <!-- Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.limelight.ui.OrbitLoaderView
                android:id="@+id/wizardBusy"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/wizardStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:maxLines="2"
                android:textColor="#B3E8E6FF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/wizardSecondary"
                style="@style/HomeChip"
                android:layout_height="38dp"
                android:layout_marginStart="12dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/wizardPrimary"
                style="@style/HomeHeroButton"
                android:layout_marginStart="12dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
