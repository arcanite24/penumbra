<?xml version="1.0" encoding="utf-8"?>
<!-- Penumbra host picker (PEN-3) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PcView">

    <com.limelight.ui.EclipseBackgroundView
        android:id="@+id/pcEclipse"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/pcContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="10dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:preferKeepClear="true">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher_foreground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.28"
                android:text="PENUMBRA"
                android:textColor="#E8E6FF"
                android:textSize="15sp"
                tools:ignore="HardcodedText" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/manuallyAddPc"
                style="@style/HomeChip"
                android:text="@string/pc_add_host" />

            <TextView
                android:id="@+id/helpButton"
                style="@style/HomeChip"
                android:text="@string/pc_help" />

            <TextView
                android:id="@+id/profilesButton"
                style="@style/HomeChip"
                android:contentDescription="@string/profile_manager_choose_profile"
                android:text="@string/home_profiles" />

            <TextView
                android:id="@+id/settingsButton"
                style="@style/HomeChip"
                android:text="@string/home_settings" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/pc_title"
            android:textColor="#FFFFFF"
            android:textSize="30sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/pc_subtitle"
            android:textColor="#B3E8E6FF"
            android:textSize="13sp" />

        <RelativeLayout
            android:id="@+id/pcFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/no_pc_found_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@drawable/home_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="24dp"
                android:paddingBottom="16dp">

                <ProgressBar
                    android:id="@+id/pcs_loading"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:indeterminate="true"
                    android:indeterminateTint="#6FE7FF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/searching_pc"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <TextView style="@style/HomeHintBadge" android:text="A" tools:ignore="HardcodedText" />
            <TextView style="@style/HomeHintLabel" android:text="@string/pc_hint_open" />
            <TextView style="@style/HomeHintBadge" android:text="Y" tools:ignore="HardcodedText" />
            <TextView style="@style/HomeHintLabel" android:text="@string/home_hint_options" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
