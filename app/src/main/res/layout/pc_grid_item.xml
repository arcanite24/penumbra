<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="208dp"
    android:layout_height="204dp"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/pc_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/home_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <RelativeLayout
            android:id="@+id/grid_image_layout"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/pc_icon_halo">

            <ImageView
                android:id="@+id/grid_image"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_centerInParent="true" />

            <ImageView
                android:id="@+id/grid_overlay"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="32dp" />

            <ProgressBar
                android:id="@+id/grid_spinner"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="32dp"
                android:indeterminate="true"
                android:indeterminateTint="#6FE7FF" />
        </RelativeLayout>

        <TextView
            android:id="@+id/grid_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/home_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="12dp"
            android:paddingBottom="3dp">

            <View
                android:id="@+id/pc_status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/home_status_dot" />

            <TextView
                android:id="@+id/pc_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#E8E6FF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
